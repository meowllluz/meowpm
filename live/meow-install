#!/bin/sh
# meow-install — Meow Linux installer (CLI).
# Manual partitioning (cfdisk) -> FAT32 on the ESP -> optional LUKS -> mkfs root
# -> unpack rootfs.tar.zst -> chroot setup (kernel + dracut + systemd-boot,
# hostname, passwords, user, doas/sudo, fstab by UUID).
set -eu

ROOTFS="${MEOW_ROOTFS:-/rootfs.tar.zst}"
MNT="/mnt"

die() { echo "meow-install: $*" >&2; exit 1; }
warn() { echo "meow-install: $*" >&2; }
ask() { printf "%s" "$1"; read -r "$2"; }
fs_of() { blkid -s TYPE -o value "$1" 2>/dev/null || true; }
size_of() { lsblk -dno SIZE "$1" 2>/dev/null | tr -d ' '; }

cleanup() {
    umount -R "$MNT" 2>/dev/null || true
    if [ -n "${LUKS_PART:-}" ]; then cryptsetup close cryptroot 2>/dev/null || true; fi
    if [ "${EFIVARS:-0}" = 1 ]; then umount /sys/firmware/efi/efivars 2>/dev/null || true; fi
}
trap cleanup EXIT INT TERM

[ "$(id -u)" = 0 ] || die "run as root"
for t in zstd cryptsetup mkfs.vfat mkfs.ext4 bootctl blkid; do
    command -v "$t" >/dev/null || die "missing tool: $t"
done
[ -f "$ROOTFS" ] || die "$ROOTFS not found"

# --- 0. sanity checks on the install archive ---
# rootfs.tar.zst must be packed as root: otherwise every installed file is owned
# by uid 1000 and su/doas/passwd lose their setuid bits (they stop working).
echo "checking $ROOTFS..."
ARCHIVE_LIST="$(zstd -dc "$ROOTFS" | tar -tvf - 2>/dev/null)" || die "cannot read $ROOTFS"
BAD_OWNER="$(printf '%s\n' "$ARCHIVE_LIST" | awk '$2 != "0/0" {c++} END {print c+0}')"
SUID_COUNT="$(printf '%s\n' "$ARCHIVE_LIST" | awk '$1 ~ /^-/ && $1 ~ /s/ {c++} END {print c+0}')"
[ "$BAD_OWNER" = 0 ] || die "rootfs.tar.zst was not packed as root ($BAD_OWNER entries with a foreign owner).
  rebuild the image: sudo ./scripts/build-rootfs.sh (it packs with --owner=0 --group=0)"
[ "$SUID_COUNT" -ge 3 ] || die "rootfs.tar.zst has no setuid bits ($SUID_COUNT) - su/doas/passwd would not work.
  rebuild the image: sudo ./scripts/build-rootfs.sh"
echo "   ok: owners 0/0, setuid files $SUID_COUNT"
echo

# --- 1. target disk and manual partitioning ---
lsblk -o NAME,SIZE,TYPE,FSTYPE,MOUNTPOINT
ask "Disk (e.g. /dev/vda): " DISK
[ -b "$DISK" ] || die "$DISK is not a block device"
cfdisk "$DISK"

echo
echo "Current layout of $DISK:"
lsblk -f "$DISK"
echo

ask "Root partition (e.g. ${DISK}2): " ROOTPART
[ -b "$ROOTPART" ] || die "$ROOTPART is not a block device"
ask "EFI partition (e.g. ${DISK}1, will be formatted FAT32): " EFIPART
[ -b "$EFIPART" ] || die "$EFIPART is not a block device"
[ "$ROOTPART" = "$EFIPART" ] && die "root and EFI are the same partition ($ROOTPART)"

# show the mapping before anything is destroyed: answering these two prompts in
# the wrong order silently wipes the ESP.
echo
echo "  root: $ROOTPART  ($(size_of "$ROOTPART"))"
echo "  EFI : $EFIPART  ($(size_of "$EFIPART"))"
ask "Is that correct? [Y/n]: " MAP_OK
case "$MAP_OK" in n|N|no) die "aborted, run meow-install again" ;; esac

ROOT_BYTES="$(blockdev --getsize64 "$ROOTPART" 2>/dev/null || echo 0)"
if [ "$ROOT_BYTES" -lt $((4 * 1024 * 1024 * 1024)) ]; then
    warn "root partition is only $((ROOT_BYTES / 1024 / 1024)) MiB; the system needs several GiB"
fi

# --- 2. the ESP is always FAT32: create it ourselves or verify ---
efi_type="$(fs_of "$EFIPART")"
case "$efi_type" in
    vfat|fat|fat32|fat16)
        ;;
    "")
        warn "$EFIPART has no filesystem - formatting it as FAT32"
        mkfs.vfat -F32 "$EFIPART"
        ;;
    *)
        die "$EFIPART contains '$efi_type', but the EFI partition must be FAT32.
  if this really is the ESP: mkfs.vfat -F32 $EFIPART
  if you swapped the partitions: rerun meow-install and answer in the other order"
        ;;
esac

# --- 3. optional LUKS on root ---
ask "Encrypt root with LUKS? [y/N]: " LUKS
LUKS_UUID=""
case "$LUKS" in
    y|Y|yes)
        [ "$(fs_of "$ROOTPART")" = "crypto_LUKS" ] || cryptsetup luksFormat "$ROOTPART"
        cryptsetup open "$ROOTPART" cryptroot
        LUKS_PART="$ROOTPART"
        ROOTDEV="/dev/mapper/cryptroot"
        LUKS_UUID="$(cryptsetup luksUUID "$ROOTPART")"
        ;;
    *)
        ROOTDEV="$ROOTPART"
        ;;
esac

# --- 4. root filesystem ---
if [ -n "$(fs_of "$ROOTDEV")" ]; then
    warn "$ROOTDEV already contains $(fs_of "$ROOTDEV") - the installation will erase it"
    ask "Continue and format it? [y/N]: " OK
    case "$OK" in y|Y|yes) ;; *) die "aborted" ;; esac
fi
ask "Root filesystem [ext4/btrfs] (ext4): " FS
FS="${FS:-ext4}"
case "$FS" in
    ext4)  mkfs.ext4 -q "$ROOTDEV" ;;
    btrfs) mkfs.btrfs -q "$ROOTDEV" ;;
    *) die "unknown filesystem: $FS" ;;
esac

# --- 5. mount root, unpack, and only then mount the ESP ---
# The ESP is mounted after unpacking: tar cannot set the owner of the ./boot
# entry on vfat ("Cannot change ownership to uid 1000: Operation not permitted").
mkdir -p "$MNT"
mount "$ROOTDEV" "$MNT" || die "cannot mount $ROOTDEV on $MNT"

echo "unpacking rootfs..."
zstd -dc "$ROOTFS" | tar -x --numeric-owner -C "$MNT" \
    || die "unpacking failed (out of space? see df -h $MNT)"

mkdir -p "$MNT/boot"
mount "$EFIPART" "$MNT/boot" || die "cannot mount $EFIPART on $MNT/boot ($(fs_of "$EFIPART"))"

BOOT_MB="$(df -m "$MNT/boot" | awk 'NR==2 {print $4}')"
if [ "${BOOT_MB:-0}" -lt 200 ]; then
    warn "only ${BOOT_MB} MiB free on the ESP; kernel + initramfs may not fit (1 GiB ESP recommended)"
fi

# rootfs.tar.zst has no virtual mountpoints - create them
mkdir -p "$MNT/dev" "$MNT/proc" "$MNT/sys" "$MNT/run" "$MNT/tmp" "$MNT/var/tmp"

# --- 6. bind virtual filesystems, copy resolv.conf ---
# systemd-boot registers itself in the firmware boot order through efivarfs; the
# live system does not mount it, so mount it here (it becomes visible in the
# chroot through the /sys bind mount). Not fatal: the fallback loader still works.
EFIVARS=0
if [ -d /sys/firmware/efi ] && ! grep -q 'efivarfs' /proc/mounts; then
    if mount -t efivarfs efivarfs /sys/firmware/efi/efivars 2>/dev/null; then
        EFIVARS=1
    else
        warn "cannot mount efivarfs: bootctl will skip the NVRAM entry"
    fi
fi

mount --bind /dev  "$MNT/dev"
mount --bind /proc "$MNT/proc"
mount --bind /sys  "$MNT/sys"
cp /etc/resolv.conf "$MNT/etc/resolv.conf"

ROOT_UUID="$(blkid -s UUID -o value "$ROOTDEV")"
[ -n "$ROOT_UUID" ] || die "cannot read the UUID of $ROOTDEV"
EFI_UUID="$(blkid -s UUID -o value "$EFIPART")"
[ -n "$EFI_UUID" ] || die "cannot read the UUID of $EFIPART"

# --- 7. fstab (root + /boot) ---
cat > "$MNT/etc/fstab" <<EOF
UUID=$ROOT_UUID	/	$FS	defaults	0 1
UUID=$EFI_UUID	/boot	vfat	defaults	0 2
EOF

# --- 8. chroot setup ---
# The setup script is written to a file and executed, NOT fed through stdin:
# a script read from stdin shares it with `read`, so the prompts would consume
# the script's own lines instead of the user's answers. Values are passed via
# the environment ("chroot ... /bin/sh -eu - a b" also fails on dash: it treats
# "-" as end of options and the next word as the script name).
SETUP="$MNT/.meow-chroot-setup.sh"
cat > "$SETUP" <<'CHROOT_EOF'
ROOT_UUID="${MEOW_ROOT_UUID:?}"
LUKS_UUID="${MEOW_LUKS_UUID:-}"

meow sync
meow install -y linux dracut systemd-boot
# meow runs no post-install hooks on purpose: the linker cache must be refreshed
# by hand, otherwise freshly installed libraries are not in /etc/ld.so.cache
ldconfig

# installed kernel version -> file names for the systemd-boot entry
KVER="$(ls /usr/lib/modules | sort -V | tail -1)"
[ -n "$KVER" ] || { echo "meow-install: no kernel installed" >&2; exit 1; }
[ -f "/boot/vmlinuz-$KVER" ] || { echo "meow-install: /boot/vmlinuz-$KVER is missing" >&2; exit 1; }

printf "Hostname: "; read -r HN; echo "$HN" > /etc/hostname

passwd root

printf "User name: "; read -r USER
useradd -m -G wheel "$USER"
passwd "$USER"

printf "Privilege escalation [doas/sudo] (doas): "; read -r ESC; ESC="${ESC:-doas}"
if [ "$ESC" = "sudo" ]; then
    meow install -y sudo
    echo '%wheel ALL=(ALL:ALL) ALL' > /etc/sudoers.d/wheel
else
    # in Void the package is named opendoas, the binary is /usr/bin/doas
    meow list | grep -q '^opendoas ' || meow install -y opendoas
    [ -x /usr/bin/doas ] || { echo "meow-install: doas was not installed" >&2; exit 1; }
    if meow list | grep -q '^sudo '; then meow remove -y sudo; fi
    echo 'permit persist :wheel' > /etc/doas.conf
    chmod 600 /etc/doas.conf
    ln -sf /usr/bin/doas /usr/bin/sudo
fi

# hostonly initramfs: small enough for a 200 MiB ESP, unlike dracut -N
if [ -n "$LUKS_UUID" ]; then
    dracut --force --add crypt /boot/initramfs.img "$KVER"
else
    dracut --force /boot/initramfs.img "$KVER"
fi
[ -f /boot/initramfs.img ] || { echo "meow-install: dracut produced no initramfs" >&2; exit 1; }

# systemd-boot: on firmware/VMs where EFI variables are not writable bootctl
# still copies its files but exits non-zero ("Failed to write
# 'LoaderSystemToken' EFI variable"); do not abort the install on that, and make
# sure the removable-media fallback loader is in place.
if ! bootctl install; then
    echo "meow-install: bootctl install reported an error (continuing)" >&2
fi
if [ ! -f /boot/EFI/BOOT/BOOTX64.EFI ]; then
    mkdir -p /boot/EFI/BOOT
    cp /usr/lib/systemd/boot/efi/systemd-bootx64.efi /boot/EFI/BOOT/BOOTX64.EFI \
        || { echo "meow-install: cannot install the EFI fallback loader" >&2; exit 1; }
fi
mkdir -p /boot/loader/entries
printf 'default meow\ntimeout 3\n' > /boot/loader/loader.conf
if [ -n "$LUKS_UUID" ]; then
    OPTIONS="rd.luks.name=$LUKS_UUID=cryptroot root=/dev/mapper/cryptroot rw"
else
    OPTIONS="root=UUID=$ROOT_UUID rw"
fi
printf 'title Meow Linux\nlinux /vmlinuz-%s\ninitrd /initramfs.img\noptions %s\n' \
    "$KVER" "$OPTIONS" > /boot/loader/entries/meow.conf

echo "installed kernel: $KVER"
echo "packages installed: $(meow list | wc -l)"
CHROOT_EOF

MEOW_ROOT_UUID="$ROOT_UUID" MEOW_LUKS_UUID="$LUKS_UUID" \
    chroot "$MNT" /bin/sh -eu /.meow-chroot-setup.sh \
    || die "chroot setup failed"
rm -f "$SETUP"

cleanup
trap - EXIT INT TERM
echo
echo "Done. Reboot and remove the installation medium."
echo
echo "Bootloader was installed automatically (systemd-boot + loader entry)."
echo "If the machine still refuses to boot, from the live ISO:"
echo "  mount <root-partition> /mnt"
echo "  mount <efi-partition> /mnt/boot"
echo "  mount --bind /dev /mnt/dev && mount --bind /proc /mnt/proc && mount --bind /sys /mnt/sys"
echo "  mount -t efivarfs efivarfs /sys/firmware/efi/efivars"
echo "  chroot /mnt bootctl install"
echo "  chroot /mnt dracut --force /boot/initramfs.img <kernel-version>"
echo "  cat /boot/loader/entries/meow.conf   # linux /vmlinuz-<ver>, initrd /initramfs.img"
